-- .gomdlint.yml --
# yaml-language-server: $schema=https://raw.githubusercontent.com/yaklabco/gomdlint/main/docs/schema/gomdlint.schema.json
# gomdlint configuration
# Rule keys are the names that 'gomdlint rules' lists. IDs such as MD013 also work.
# See: https://github.com/yaklabco/gomdlint
#
# This template lists every rule with its built-in settings. A rule's
# severity and options are comments, so the file changes nothing until you
# uncomment and edit them. 'gomdlint explain <rule>' describes a rule and
# its options.
#
# Run-time settings are command-line flags and cannot be set in this file:
# --fix, --dry-run, --jobs, --format, --enable, --disable and --fix-rules.

# Markdown flavor: commonmark or gfm
flavor: gfm

# Severity for every rule that does not set one: error, warning, or info.
# Leave it unset to keep each rule's built-in severity.
# severity_default: error

# Backup configuration for auto-fix
backups:
  enabled: true
  mode: sidecar

# Skip files that .gitignore files ignore when walking directories
gitignore: true

# Skip node_modules and vendor directories when walking directories
default_ignores: true

# File patterns to ignore (glob patterns, relative to this file)
# ignore:
#   - "docs/drafts/**"
#   - "CHANGELOG.md"

# Rule settings, keyed by rule name, by category. A severity set here
# overrides severity_default for that rule.
rules:
  # Headings

  # Comments aside, the file starts with a top-level heading or front matter
  # title.
  first-line-heading:            # MD041
    enabled: true
    # severity: warning
    # options:
    #   level: 1
    #   front_matter_title: ^\s*"?title"?\s*[:=]
    #   allow_preamble: false

  # Headings have a blank or comment line above and below.
  heading-blank-lines:           # MD022
    enabled: true
    # severity: warning
    # options:
    #   lines_above: 1
    #   lines_below: 1
    #   include_front_matter: false
    #   markdownlint_compatible: true

  # Each heading is at most one level deeper than the heading or title before
  # it.
  heading-increment:             # MD001
    enabled: true
    # severity: warning
    # options:
    #   front_matter_title: ^\s*"?title"?\s*[:=]

  # Headings start at the beginning of their line, list item or blockquote.
  heading-start-left:            # MD023
    enabled: true
    # severity: warning

  # Headings all use the first heading's style: # Title, # Title #, or
  # underlined.
  heading-style:                 # MD003
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, atx, atx_closed, setext, setext_with_atx, setext_with_atx_closed
    #   require_closing_atx: false

  # No two headings have exactly the same text.
  no-duplicate-heading:          # MD024
    enabled: true
    # severity: warning
    # options:
    #   siblings_only: false

  # Outside lists and blockquotes, a bold or italic line is not a stand-in
  # heading.
  no-emphasis-as-heading:        # MD036
    enabled: true
    # severity: warning
    # options:
    #   punctuation: .,;:!?。，；：！？

  # A space follows the # marks that open a heading at the start of a line.
  no-missing-space-atx:          # MD018
    enabled: true
    # severity: warning

  # A closed heading at the start of a line has a space inside each run of #.
  no-missing-space-closed-atx:   # MD020
    enabled: true
    # severity: warning

  # Only one space follows the # marks that open a heading.
  no-multiple-space-atx:         # MD019
    enabled: true
    # severity: warning

  # A closed heading has only one space inside each run of #.
  no-multiple-space-closed-atx:  # MD021
    enabled: true
    # severity: warning

  # Headings do not end with a period, comma, semicolon, colon or exclamation
  # mark.
  no-trailing-punctuation:       # MD026
    enabled: true
    # severity: warning
    # options:
    #   punctuation: .,;:!。，；：！

  # Headings follow the configured outline in order. No outline is set by
  # default.
  required-headings:             # MD043
    enabled: true
    # severity: warning
    # options:
    #   headings: []
    #   match_case: false

  # A document that starts with a title has no other top-level heading.
  single-h1:                     # MD025
    enabled: true
    # severity: warning
    # options:
    #   level: 1
    #   front_matter_title: ^\s*"?title"?\s*[:=]
    #   title_only: true
    #   allow_no_h1: true

  # Lists

  # Lists outside other lists have a blank or comment line above and below.
  blanks-around-lists:   # MD032
    enabled: true
    # severity: warning

  # Items in a list start at the same column. Ordered numbers may right-align.
  list-indent:           # MD005
    enabled: true
    # severity: warning

  # One space, or one tab, separates each list marker from the item's text.
  list-marker-space:     # MD030
    enabled: true
    # severity: warning
    # options:
    #   ul_single: 1
    #   ol_single: 1
    #   ul_multi: 1
    #   ol_multi: 1

  # Ordered list items are numbered 1, 1, 1, or 1, 2, 3, or 0, 1, 2, and so on.
  ol-prefix:             # MD029
    enabled: true
    # severity: warning
    # options:
    #   style: one_or_ordered  # one, ordered, one_or_ordered, zero
    #   allow_renumbering: true

  # Outside ordered lists, bullets sit at the margin and indent 2 spaces per
  # level.
  ul-indent:             # MD007
    enabled: true
    # severity: warning
    # options:
    #   indent: 2
    #   start_indented: false
    #   start_indent: 2  # defaults to the value of indent

  # Every bullet uses the same marker as the first bullet in the file.
  unordered-list-style:  # MD004
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, asterisk, plus, dash, sublist

  # Whitespace and layout

  # Every horizontal rule is written the same way as the first one, such as ---.
  hr-style:                 # MD035
    enabled: true
    # severity: warning
    # options:
    #   style: consistent

  # Lines fit in 80 characters, with exemptions such as lone links and
  # definitions.
  line-length:              # MD013
    enabled: true
    # severity: warning
    # options:
    #   max: 80
    #   heading_max: 80  # defaults to the value of max
    #   code_block_max: 80  # defaults to the value of max
    #   ignore_code_blocks: false
    #   ignore_tables: false
    #   ignore_headings: false
    #   ignore_urls: false
    #   strict: false
    #   stern: false
    #   markdownlint_compatible: true

  # Lines contain no tab characters, including inside code.
  no-hard-tabs:             # MD010
    enabled: true
    # severity: warning
    # options:
    #   code_blocks: true
    #   ignore_code_languages: []
    #   spaces_per_tab: 1

  # Outside code, no two blank lines follow each other, except after front
  # matter.
  no-multiple-blank-lines:  # MD012
    enabled: true
    # severity: warning
    # options:
    #   max_consecutive: 1

  # Outside code blocks, lines end in no spaces or tabs, or in exactly 2 of
  # them.
  no-trailing-spaces:       # MD009
    enabled: true
    # severity: warning
    # options:
    #   br_spaces: 2
    #   list_item_empty_lines: false
    #   strict: false
    #   ignore_code_blocks: true

  # The file ends with a newline, or a last line of only whitespace, > or
  # comments.
  single-trailing-newline:  # MD047
    enabled: true
    # severity: warning
    # options:
    #   max_trailing_blank_lines:  # unset by default

  # Code

  # Fenced code blocks have a blank or comment line above and below.
  blanks-around-fences:  # MD031
    enabled: true
    # severity: warning
    # options:
    #   list_items: true

  # Code blocks all use the first block's style, fenced or indented.
  code-block-style:      # MD046
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, fenced, indented

  # Code fences all use the first fence's character, backtick or tilde.
  code-fence-style:      # MD048
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, backtick, tilde

  # Code blocks that show only commands leave out the $ prompt.
  commands-show-output:  # MD014
    enabled: true
    # severity: warning

  # Fenced code blocks name their language after the opening fence.
  fenced-code-language:  # MD040
    enabled: true
    # severity: warning
    # options:
    #   allowed_languages: []
    #   language_only: false

  # Code span text has no spaces around it, except one each side or by a
  # backtick.
  no-space-in-code:      # MD038
    enabled: true
    # severity: warning

  # Links and images

  # Link text describes its target instead of saying "click here" or "more".
  descriptive-link-text:             # MD059
    enabled: true
    # severity: warning
    # options:
    #   patterns: [click here, here, link, more]
    #   markdownlint_compatible: true

  # Relative links and local file: URLs are not mixed in one document.
  link-destination-style:            # MDL001
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, relative, absolute

  # Links to a #fragment point at a heading or anchor in the same file, or at
  # #top.
  link-fragments:                    # MD051
    enabled: true
    # severity: warning
    # options:
    #   ignore_case: false
    #   ignored_pattern: ""

  # Every reference definition is used and defined once, except [//] comments.
  link-image-reference-definitions:  # MD053
    enabled: true
    # severity: warning
    # options:
    #   ignored_definitions: [//]

  # Links and images use only the allowed styles. By default, all are allowed.
  link-image-style:                  # MD054
    enabled: true
    # severity: warning
    # options:
    #   autolink: true
    #   inline: true
    #   full: true
    #   collapsed: true
    #   shortcut: true
    #   url_inline: true

  # Markdown images have alt text, and HTML images have alt or
  # aria-hidden="true".
  no-alt-text:                       # MD045
    enabled: true
    # severity: warning

  # Outside code and HTML, URLs and email addresses sit in angle brackets or
  # links.
  no-bare-urls:                      # MD034
    enabled: true
    # severity: warning

  # Inline links have a destination, and no link points at just #.
  no-empty-links:                    # MD042
    enabled: true
    # severity: warning

  # Inline links put the text in brackets and the URL in parentheses:
  # [text](url).
  no-reversed-links:                 # MD011
    enabled: true
    # severity: warning

  # Link text has no spaces just inside its brackets.
  no-space-in-links:                 # MD039
    enabled: true
    # severity: warning

  # Labels in [text][label] and [label][] references are defined, except x.
  reference-links-images:            # MD052
    enabled: true
    # severity: warning
    # options:
    #   ignored_labels: [x]
    #   shortcut_syntax: false

  # Tables

  # Tables have a blank or comment line above and below.
  blanks-around-tables:  # MD058
    enabled: true
    # severity: warning

  # Each cell of a table's delimiter row has at least 3 dashes.
  table-alignment:       # MDL003
    enabled: true
    # severity: warning
    # options:
    #   min_dashes: 3

  # Every table row has as many cells as the header row.
  table-column-count:    # MD056
    enabled: true
    # severity: warning

  # Each table follows one style: aligned pipes, one space of padding, or none.
  table-column-style:    # MD060
    enabled: true
    # severity: warning
    # options:
    #   style: any  # any, aligned, compact, tight
    #   aligned_delimiter: false
    #   markdownlint_compatible: true

  # Table rows use leading and trailing pipes the same way throughout.
  table-pipe-style:      # MD055
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, leading_only, trailing_only, leading_and_trailing, no_leading_or_trailing

  # Emphasis

  # All italic text uses one marker, *text* or _text_, except * inside a word.
  emphasis-style:        # MD049
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, asterisk, underscore

  # Emphasis markers touch the text they wrap, as in **bold**.
  no-space-in-emphasis:  # MD037
    enabled: true
    # severity: warning

  # All bold text uses one marker, **text** or __text__, except ** inside a
  # word.
  strong-style:          # MD050
    enabled: true
    # severity: warning
    # options:
    #   style: consistent  # consistent, asterisk, underscore

  # Blockquotes

  # No blank line sits between two blockquotes.
  no-blanks-blockquote:          # MD028
    enabled: true
    # severity: warning

  # Outside code and list item text, at most one space follows a blockquote's >.
  no-multiple-space-blockquote:  # MD027
    enabled: true
    # severity: warning
    # options:
    #   list_items: true

  # HTML

  # Documents contain no raw HTML elements other than allowed ones.
  no-inline-html:  # MD033
    enabled: true
    # severity: warning
    # options:
    #   allowed_elements: []
    #   table_allowed_elements: []  # defaults to the value of allowed_elements

  # Spelling

  # Outside URLs, proper names match the configured capitals, none by default.
  proper-names:  # MD044
    enabled: true
    # severity: warning
    # options:
    #   names: []
    #   code_blocks: true
    #   html_elements: true
